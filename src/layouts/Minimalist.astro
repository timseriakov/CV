---
import "../styles.css";
type Props = {
  frontmatter: { title: string; description?: string; pdfLink?: string; noIndex?: boolean };
  home?: boolean;
};
const { frontmatter: { title, description, noIndex }, home = false } = Astro.props;
const projects = Astro.url.pathname === "/projects";
const pdf = Boolean(import.meta.env.PDF_VIEW || Astro.url.searchParams.has("pdf"));
const theme = import.meta.env.FORCE_THEME || "";
---
<!doctype html>
<html lang="ru" class={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || title} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={[{ "pdf-view": pdf, homepage: home }]}>
    <main class:list={[{ resume: !home }]}><article><slot /></article></main>
    {!pdf && <nav aria-label="Основная навигация" class="menu-v2">
      <div class="menu-v2-inner">
        <div id="menu-links" inert>
          <a href="/" aria-current={home ? "page" : undefined}>Главная</a>
          <span class="menu-v2-divider" aria-hidden="true"></span>
          <a href="/resume" aria-current={!home && !projects ? "page" : undefined}>Резюме</a>
          <a href="/projects" aria-current={projects ? "page" : undefined}>Проекты</a>
          <a href="/Timofei-Seriakov-CV.pdf" download aria-label="Скачать резюме в PDF">Резюме PDF</a>
          <span class="menu-v2-divider" aria-hidden="true"></span>
          <a href="mailto:t.seriakov@gmail.com">Написать</a>
        </div>
        <button type="button" class="menu-v2-trigger" aria-expanded="false" aria-controls="menu-links">Меню</button>
      </div>
    </nav>}
    <script>
      const menu = document.querySelector<HTMLElement>(".menu-v2");
      const trigger = document.querySelector<HTMLButtonElement>(".menu-v2-trigger");
      const links = document.querySelector<HTMLElement>("#menu-links");
      const setOpen = (open: boolean) => {
        menu?.classList.toggle("is-open", open);
        trigger?.setAttribute("aria-expanded", String(open));
        if (trigger) trigger.textContent = open ? "Закрыть" : "Меню";
        if (links) links.inert = !open;
      };
      trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.classList.contains("is-open")) {
          setOpen(false);
          trigger?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && menu && !menu.contains(event.target)) setOpen(false);
      });
      if (new URLSearchParams(location.search).has("pdf")) {
        document.body.classList.add("pdf-view");
        menu?.remove();
      }
    </script>
  </body>
</html>
